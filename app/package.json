{
  "name": "local-transcriber",
  "version": "0.1.0",
  "description": "Local multi-speaker transcriber (de/en/fr/es)",
  "main": "dist-electron/main.cjs",
  "private": true,
  "license": "Unlicense",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "npm run build:electron && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --format=cjs --outdir=dist-electron --out-extension:.js=.cjs",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "links:check": "node scripts/check-source-links.mjs",
    "contrast:check": "node scripts/contrast-check.mjs",
    "built:check": "node scripts/check-built-app.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wavesurfer.js": "^8.0.2"
  }
}
